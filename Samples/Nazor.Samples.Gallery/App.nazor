@window
@using Nazor.Themes.NazorLeaf

<GalleryView>
    <Caption Context="gallery">
        <UserTitleBar Class="gallery-titlebar" Height="TitleBarHeight.Tall" Title="Nazor Gallery">
            <AppIcon><Image Class="titlebar-mark" Source="@gallery.BrandMark" /></AppIcon>
            <Center>
                <SearchField TItem="GalleryEntry" Id="gallery-caption-search" Class="titlebar-search" @bind-Value="gallery.SearchText"
                             AccessibleName="Search components" Placeholder="Search components" Suggestions="GalleryCatalog.Entries" Filter="(entry, text) => entry.Matches(text)"
                             ItemText="entry => entry.Title" SuggestionChosen="gallery.ShowFromSearch" />
            </Center>
        </UserTitleBar>
    </Caption>
</GalleryView>

@code {
    public static StyleSheet LeafTheme { get; } = StyleSheet.Combine(NazorLeafTheme.Theme, StyleSheets.Showcase);

    protected override void OnInitialized()
    {
        Window.Decorations = WindowDecorationPolicy.Prefer(
            WindowDecorations.Native(WindowTitleBarContent.User, WindowCaptionButtons.Native),
            WindowDecorations.Nazor(WindowTitleBarContent.User, WindowCaptionButtons.Nazor));
        Window.Title = "Nazor Gallery";
        Window.Width = 1180;
        Window.Height = 820;
    }
}

@style {
    :root { -windows-title-bar-height: tall; }
    .gallery-titlebar { gap: 0; padding-left: 16px; }
    .gallery-titlebar TitleBarAppIcon { min-width: 16px; margin-right: 16px; }
    .gallery-titlebar TitleBarTitle { font-size: 12px; }
    .gallery-titlebar TitleBarCenter { display: flex; align-items: center; flex: 1; min-width: 0; justify-content: center; padding: 0 16px; }
    .titlebar-mark { width: 16px; height: 16px; }
    .titlebar-search { flex: 0 1 520px; min-width: 160px; }
    :root:is(.gallery-leaf, .gallery-fluent) .gallery-titlebar {
        padding-left: 8px;
        TitleBarAppIcon { margin-left: 0; margin-right: 12px; }
        TitleBarHeading { flex: 0 1 196px; }
        TitleBarTitle { font-size: 16px; font-weight: 600; }
        TitleBarCenter { justify-content: flex-start; }
        .titlebar-mark { width: 32px; height: 32px; }
        .titlebar-search { min-height: 32px; height: 32px; font-size: 14px; }
    }
    @media (max-width: 720px) {
        :root:is(.gallery-leaf, .gallery-fluent) .gallery-titlebar TitleBarHeading { flex-basis: auto; }
    }
    :root.gallery-none .gallery-titlebar { display: flex; align-items: center; min-height: 48px; }
    :root.gallery-none .titlebar-search { display: flex; align-items: center; min-height: 32px; padding: 4px 8px; }
    :root.gallery-none .titlebar-search > SearchFieldInput { display: block; flex: 1; min-width: 0; }
}
