<Field LabelText="Demo password"><PasswordField @bind-Value="password" /></Field>
<Field LabelText="Four-digit verification code"><PinField Length="4" Mask="true" @bind-Value="pin" /></Field>
<TextBlock>@(pin.Length == 4 ? "Code complete" : "Enter four digits")</TextBlock>
@code { private string password = ""; private string pin = ""; }
