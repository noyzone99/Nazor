<Container Class="demo-section">
    <Heading Level="3">Tipografia e tag HTML5</Heading>
    <Paragraph Class="demo-lead">Bricolage Grotesque per i titoli, con il suo disegno un po’ irregolare che dà voce all’app; Geist per l’interfaccia, neutro e nitido ai corpi piccoli.</Paragraph>
    <Container Class="demo-card demo-ramp">
        @foreach (var (text, cls, spec) in ramp)
        {
            <Container Class="demo-ramp-row"><TextBlock Class="@cls">@text</TextBlock><TextBlock Class="demo-spec">@spec</TextBlock></Container>
        }
    </Container>
    <Container Class="demo-prose">
        <Heading Level="1">Un toolkit, ogni piattaforma</Heading>
        <Paragraph IsTextSelectionEnabled="true">Ogni controllo è disegnato da <Strong>Skia</Strong> sulla stessa superficie, quindi un pulsante è identico su Windows, macOS e Linux. I gesti invece seguono il sistema: il <Emphasis>menu contestuale</Emphasis> si apre dove ci si aspetta e le scorciatoie usano <Kbd>Ctrl</Kbd> + <Kbd>S</Kbd> oppure <Kbd>⌘</Kbd> + <Kbd>S</Kbd>.</Paragraph>
        <Paragraph IsTextSelectionEnabled="true">Il <Mark>seme del tema</Mark> vive in <InlineCode>--leaf-g3</InlineCode>. Il testo usa <Abbreviation Tooltip="Web Content Accessibility Guidelines" AccessibleDescription="Web Content Accessibility Guidelines">WCAG</Abbreviation> per misurare il contrasto. <Deleted>Un colore fisso</Deleted> <Inserted>Un colore derivato dal seme</Inserted> mantiene la gerarchia. H<Subscript>2</Subscript>O e x<Superscript>2</Superscript> condividono la riga.</Paragraph>
        <Paragraph><Quote>Una forma riconoscibile, un comportamento prevedibile.</Quote> <SmallText>Leggi la <Link NavigateUri="@(new Uri("https://learn.microsoft.com/dotnet/"))">documentazione .NET</Link>.</SmallText></Paragraph>
        <Heading Level="2">Principi</Heading>
        <Heading Level="3">Riconoscibile da lontano</Heading>
        <List><ListItem>La sagoma a foglia vale per ogni elemento.</ListItem><ListItem>Il seme segna sempre la selezione.</ListItem><ListItem>Solo ciò che è pieno di colore emette luce.</ListItem></List>
        <Heading Level="4">Ordine di rendering</Heading>
        <List Ordered="true"><ListItem>Vassoio della finestra</ListItem><ListItem>Riquadri del contenuto</ListItem><ListItem>Controlli e testo</ListItem><ListItem>Menu, suggerimenti e notifiche</ListItem></List>
        <Blockquote Cite="Linee guida di Nazor">Un’app Nazor deve essere riconoscibile anche sfocata, a dieci metri, in una miniatura.</Blockquote>
        <Heading Level="5">Definizioni</Heading>
        <DefinitionList Layout="DefinitionListLayout.Inline">
            <DefinitionTerm>Vassoio</DefinitionTerm><DefinitionDescription>Il fondo della finestra, tinto dal seme.</DefinitionDescription>
            <DefinitionTerm>Riquadro</DefinitionTerm><DefinitionDescription>La superficie piena su cui poggia il contenuto.</DefinitionDescription>
            <DefinitionTerm>Seme</DefinitionTerm><DefinitionDescription>Il colore d’origine e il segno della selezione.</DefinitionDescription>
        </DefinitionList>
        <Heading Level="6">Esempio di configurazione</Heading>
        <CodeBlock Language="csharp">// Tema generato dal seme corrente
var builder = NazorApplication.CreateBuilder(args);
builder.Fonts.AddNazorLeafFonts();</CodeBlock>
        <Container Class="demo-meas">
            <Container Class="demo-meas-row"><TextBlock>Elemento progress</TextBlock><ProgressBar Value="70" AccessibleName="Elemento progress" /></Container>
            <Container Class="demo-meas-row"><TextBlock>Elemento meter</TextBlock><Meter Value="60" Maximum="100" Low="30" High="80" Optimum="90" AccessibleName="Elemento meter" /></Container>
        </Container>
    </Container>
</Container>

@code {
    private readonly (string, string, string)[] ramp =
    [
        ("Disegnato con Skia", "demo-t-d", "display 52"), ("Titolo della pagina", "demo-t-1", "h1 34/38"), ("Titolo di sezione", "demo-t-2", "h2 26/31"),
        ("Titolo di gruppo", "demo-t-3", "h3 20/26"), ("Titolo di scheda", "demo-t-4", "h4 17/23"), ("Titolo di elenco", "demo-t-5", "h5 15/21"),
        ("Titolo di nota", "demo-t-6", "h6 13/18"), ("Corpo del testo per paragrafi e controlli.", "demo-t-b", "corpo 14/22"), ("Didascalia per metadati e aiuti.", "demo-t-c", "didascalia 12/16"),
    ];
}
@style {
    .demo-ramp-row { display: flex; flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 20px; padding: 11px 0; border-bottom: 1px dashed var(--leaf-stroke-2); }
    .demo-ramp-row:last-child { border-bottom: 0; }
    .demo-spec { font-family: var(--leaf-font-mono); font-size: 11.5px; font-weight: 500; color: var(--leaf-text-3); white-space: pre; }
    .demo-t-d { font-variation-settings: "opsz" 96; font-family: var(--leaf-font-display); font-size: 52px; font-weight: 800; line-height: 1; letter-spacing: -0.045em; }
    .demo-t-1 { font-variation-settings: "opsz" 72; font-family: var(--leaf-font-display); font-size: 34px; font-weight: 800; line-height: 1.1; letter-spacing: -0.035em; }
    .demo-t-2 { font-family: var(--leaf-font-display); font-size: 26px; font-weight: 750; line-height: 1.2; letter-spacing: -0.025em; }
    .demo-t-3 { font-family: var(--leaf-font-display); font-size: 20px; font-weight: 700; line-height: 1.3; letter-spacing: -0.015em; }
    .demo-t-4 { font-size: 17px; font-weight: 650; line-height: 1.35; letter-spacing: -0.005em; }
    .demo-t-5 { font-size: 15px; font-weight: 650; line-height: 1.4; }
    .demo-t-6 { font-size: 13px; font-weight: 650; line-height: 1.4; color: var(--leaf-text-2); }
    .demo-t-b { font-size: 14px; line-height: 1.55; }
    .demo-t-c { font-size: 12px; color: var(--leaf-text-2); }
    .demo-prose { display: flex; flex-direction: column; max-width: 68ch; margin-top: 30px; }
    .demo-meas { display: flex; flex-direction: column; gap: 12px; margin-top: 14px; }
    .demo-meas-row { display: flex; flex-direction: row; align-items: center; gap: 14px; font-size: 13.5px; }
    .demo-meas-row > TextBlock { min-width: 150px; }
    .demo-meas-row > ProgressBar, .demo-meas-row > Meter { width: 220px; }
}
