<Project>
  <Import Project="../../Sources/Tools/Nazor.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <NazorApplicationId>org.nazor.samples.gallery</NazorApplicationId>
    <RootNamespace>Nazor.Samples.Gallery</RootNamespace>
    <NazorEnableDevTools Condition="'$(NazorEnableDevTools)' == '' and '$(Configuration)' == 'Debug'">true</NazorEnableDevTools>
  </PropertyGroup>
  <Import Project="../../Sources/Tools/Nazor.Sdk/Sdk/Sdk.targets" />
  <PropertyGroup Condition="'$(_NazorRuntimePlatform)' == 'portable' or '$(_NazorRuntimePlatform)' == 'linux'">
    <DefineConstants>$(DefineConstants);GALLERY_DRM</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Sources/Themes/Nazor.Themes.Adwaita/Nazor.Themes.Adwaita.csproj" />
    <ProjectReference Include="../../Sources/Themes/Nazor.Themes.Breeze/Nazor.Themes.Breeze.csproj" />
    <ProjectReference Include="../../Sources/Themes/Nazor.Themes.Windows9x/Nazor.Themes.Windows9x.csproj" />
    <ProjectReference Include="../../Sources/Themes/Nazor.Themes.WindowsXP/Nazor.Themes.WindowsXP.csproj" />
    <ProjectReference Include="../../Sources/Themes/Nazor.Themes.Windows7/Nazor.Themes.Windows7.csproj" />
    <ProjectReference Include="../../Sources/Themes/Nazor.Themes.Cde/Nazor.Themes.Cde.csproj" />
    <ProjectReference Include="../../Sources/Themes/Nazor.Themes.Fluent/Nazor.Themes.Fluent.csproj" />
    <ProjectReference Include="../../Sources/Themes/Nazor.Themes.NazorLeaf/Nazor.Themes.NazorLeaf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Examples/**/*.nazor" LogicalName="GallerySamples.%(Filename)%(Extension)" />
    <None Include="../../Docs/Assets/nazor.png" Link="Assets/nazor.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../Docs/Assets/nazor-app.png" Link="Assets/nazor-app.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
