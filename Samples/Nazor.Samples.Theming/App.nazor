@window
@inject IApplicationAppearance Appearance
@inject IWindowService Windows
@using Nazor.Style
@using Nazor.Themes.Adwaita
@using Nazor.Themes.Breeze
@using Nazor.Themes.Cde
@using Nazor.Themes.NazorLeaf
@using Nazor.Themes.Windows7
@using Nazor.Themes.Windows9x
@using Nazor.Themes.WindowsXP

<Container Class="scroll-fill">
	<Container Class="page">
		<TextBlock Class="title">Window themes</TextBlock>
		<Container Class="row chrome-preview">
			<Button OnClick="OpenPreview">Open comparison window</Button>
			<TextBlock Class="muted">@DecorationStatus</TextBlock>
		</Container>
		<Container Class="settings">
			<Field LabelText="Title bar">
				<Select TValue="bool" @bind-Value="SystemTitleBar" Id="titlebar-owner" Disabled="@DecorationSelectionDisabled">
					<SelectItem Value="@false">Theme</SelectItem>
					<SelectItem Value="@true">System</SelectItem>
				</Select>
			</Field>
			<Field LabelText="Window frame">
				<Select TValue="WindowFrameOwner" @bind-Value="FrameOwner" Id="frame-owner" Disabled="@DecorationSelectionDisabled">
					<SelectItem Value="@WindowFrameOwner.Nazor">Theme</SelectItem>
					<SelectItem Value="@WindowFrameOwner.Native">System</SelectItem>
				</Select>
			</Field>
			<Container Class="section">
				<Button Id="apply-decorations" Disabled="@(!CanApplyDecorations)" OnClick="ApplyDecorationsAsync">Apply decorations</Button>
				<TextBlock Class="muted" @attributes="statusAttributes">@DecorationFeedback</TextBlock>
			</Container>
		</Container>
		<Container Class="settings">
			<Container Class="section">
				<Field LabelText="Theme">
					<Select TValue="string" @bind-Value="Theme" Id="theme-picker">
						@foreach (var option in Themes)
						{
							<SelectItem Value="@option.Id">@option.Label</SelectItem>
						}
					</Select>
				</Field>
				<CheckBox @bind-IsChecked="CustomAccent">Custom accent</CheckBox>
			</Container>
			<Container Class="section">
				<TextBlock Class="heading">Color scheme</TextBlock>
				<RadioGroup @bind-Value="Scheme" AccessibleName="Color scheme">
					<RadioButton Value="@("system")">System</RadioButton>
					<RadioButton Value="@("light")">Light</RadioButton>
					<RadioButton Value="@("dark")">Dark</RadioButton>
				</RadioGroup>
				<TextBlock Class="muted">System follows platform preferences, including changes made while the app is running.</TextBlock>
			</Container>
			<Container Class="section">
				<TextBlock Class="heading">Backdrop</TextBlock>
				<Select @bind-Value="BackdropChoice" AccessibleName="Window material">
					<SelectItem Value="@("none")">None</SelectItem>
					<SelectItem Value="@("blur")">Blur</SelectItem>
					<SelectItem Value="@("solid")">Solid</SelectItem>
					<SelectItem Value="@("mica")">Mica (Windows)</SelectItem>
					<SelectItem Value="@("mica-alt")">Mica Alt (Windows)</SelectItem>
					<SelectItem Value="@("acrylic")">Acrylic (Windows)</SelectItem>
					<SelectItem Value="@("linux-blur")">Blur (Linux)</SelectItem>
				</Select>
				<TextBlock Class="muted">Blur maps to Acrylic on Windows and blur on Linux. Solid maps to Mica on Windows and no effect on Linux; unsupported materials use the theme background.</TextBlock>
			</Container>
		</Container>
		<Container Class="panels">
			<Container Class="panel">
				<TextBlock Class="heading">Control preview</TextBlock>
				<Container Class="row">
					<Button IsDefault="true" OnClick="Save">Save</Button>
					<Button OnClick="Reset">Reset</Button>
					<Button Disabled="true">Disabled</Button>
				</Container>
				<TextField Class="project-name" @bind-Value="name" Placeholder="Project name" AccessibleName="Project name" />
				<TextBlock Class="generated-preview">Decorative NSS content</TextBlock>
				<CheckBox @bind-IsChecked="notifications">Receive updates</CheckBox>
				<Switch @bind-IsOn="synchronization">Synchronization</Switch>
				<Slider @bind-Value="progress" AccessibleName="Progress" />
				<ProgressBar Value="@progress" AccessibleName="Progress preview" />
				<TextBlock Class="muted" @attributes="statusAttributes">@status</TextBlock>
			</Container>
			<Container Class="panel">
				<TextBlock Class="heading">System colors</TextBlock>
				<TextBlock>NSS color names read the resolved platform palette for the current appearance. High-contrast themes use the system's chosen colors.</TextBlock>
				<TextBlock Class="swatch canvas">Canvas / CanvasText</TextBlock>
				<TextBlock Class="swatch field">Field / FieldText</TextBlock>
				<TextBlock Class="swatch highlight">Highlight / HighlightText</TextBlock>
				<TextBlock Class="swatch accent">AccentColor / AccentColorText</TextBlock>
				<TextBlock Class="muted">Try hover, pressed states, Tab, and disabled controls. The backdrop remains visible between panels.</TextBlock>
			</Container>
		</Container>
	</Container>
</Container>

@code {
	private static readonly (string Id, string Label, StyleSheet Sheet)[] Themes =
	[
		("basic", "Basic", Nazor.Themes.Themes.Basic),
		("fluent", "Fluent", Nazor.Themes.Fluent.Themes.Fluent),
		("nazor-leaf", "NazorLeaf", NazorLeafTheme.Theme),
		("adwaita", "Adwaita", AdwaitaTheme.Theme),
		("breeze", "Breeze", BreezeTheme.Theme),
		("windows-9x", "Windows 9x", Windows9xTheme.Theme),
		("windows-xp", "Windows XP", WindowsXPTheme.Theme),
		("windows-7", "Windows 7", Windows7Theme.Theme),
		("cde", "CDE", CdeTheme.Theme),
		("none", "None", StyleSheet.Combine(Nazor.Themes.Themes.None, StyleSheets.UnstyledChrome)),
	];
	private static readonly WindowDecorations ThemeDecorations = WindowDecorations.Nazor();
	private static readonly WindowDecorations SystemDecorations = WindowDecorations.Native();
	private static readonly WindowDecorations ThemeTitleBarWithSystemFrame =
		WindowDecorations.Native(WindowTitleBarContent.Nazor, WindowCaptionButtons.Nazor);

	protected override void OnInitialized()
	{
		Window.Title = "Nazor — Theming";
		Window.Width = 1080;
		Window.Height = 820;
		Window.Decorations = WindowDecorationPolicy.Prefer(ThemeDecorations);
		Window.Backdrop = SelectedBackdrop;
	}

	private bool customAccent;
	private string? backdrop = "none";
	private string Theme
	{
		get => Themes.FirstOrDefault(option => ReferenceEquals(option.Sheet, Appearance.Theme)).Id ?? "basic";
		set => Appearance.Theme = Themes.FirstOrDefault(option => option.Id == value).Sheet ?? Nazor.Themes.Themes.Basic;
	}
	private WindowDecorations? AppliedDecorations => Window.AppliedDecorations?.Configuration;
	private bool? systemTitleBar;
	private WindowFrameOwner? frameOwner;
	private bool applyingDecorations;
	private string? decorationError;
	private bool SystemTitleBar
	{
		get => systemTitleBar ?? AppliedDecorations?.HasNativeTitleBar ?? false;
		set { systemTitleBar = value; decorationError = null; }
	}
	private WindowFrameOwner FrameOwner
	{
		get => frameOwner ?? AppliedDecorations?.Frame ?? WindowFrameOwner.Nazor;
		set { frameOwner = value; decorationError = null; }
	}
	private WindowDecorations? RequestedDecorations => (SystemTitleBar, FrameOwner) switch
	{
		(true, WindowFrameOwner.Native) => SystemDecorations,
		(false, WindowFrameOwner.Native) => ThemeTitleBarWithSystemFrame,
		(false, WindowFrameOwner.Nazor) => ThemeDecorations,
		_ => null,
	};
	private WindowDecorationSupport GetDecorationSupport(WindowDecorations? request) => request is null
		? new(WindowSupportStatus.Unsupported, "The system title bar requires the system frame.")
		: Window.Capabilities.Decorations.GetChangeSupport(request);
	private bool DecorationSelectionDisabled => applyingDecorations || AppliedDecorations is null;
	private bool CanApplyDecorations => !DecorationSelectionDisabled && RequestedDecorations is { } request &&
		request != AppliedDecorations && GetDecorationSupport(request).Status != WindowSupportStatus.Unsupported;
	private string DecorationStatus => AppliedDecorations switch
	{
		{ HasNativeTitleBar: true } => "Applied: System title bar and frame",
		{ Frame: WindowFrameOwner.Native } => "Applied: Theme title bar, system frame",
		{ Frame: WindowFrameOwner.Nazor } => "Applied: Theme title bar and frame",
		_ => "Waiting for window decorations…",
	};
	private string? DecorationFeedback
	{
		get
		{
			if (applyingDecorations) return "Applying decorations…";
			if (decorationError is not null) return decorationError;
			var request = RequestedDecorations;
			if (AppliedDecorations is null || request == AppliedDecorations) return null;
			var support = GetDecorationSupport(request);
			return support.Status switch
			{
				WindowSupportStatus.Unsupported => support.Reason,
				WindowSupportStatus.Unknown => "The backend must negotiate this combination.",
				_ => null,
			};
		}
	}
	private async Task ApplyDecorationsAsync()
	{
		if (!CanApplyDecorations || RequestedDecorations is not { } request) return;
		applyingDecorations = true;
		decorationError = null;
		try
		{
			await Window.SetDecorationsAsync(WindowDecorationPolicy.Require(request));
			systemTitleBar = null;
			frameOwner = null;
		}
		catch (Exception error) when (error is PlatformNotSupportedException or AggregateException)
		{
			decorationError = error.Message;
		}
		catch (OperationCanceledException) when (Window.IsClosed) { }
		finally { applyingDecorations = false; }
	}
	private void OpenPreview() => Windows.Open<PreviewWindow>(
		new Dictionary<string, object?> { [nameof(PreviewWindow.PreferredDecorations)] = AppliedDecorations },
		new WindowOpenOptions { StartupLocation = WindowStartupLocation.CenterScreen });
	private string? BackdropChoice { get => backdrop; set { backdrop = value; Window.Backdrop = SelectedBackdrop; } }
	private bool CustomAccent { get => customAccent; set { customAccent = value; Window.Class = value ? "custom-accent" : ""; } }
	private string name = "Nazor project";
	private bool notifications = true;
	private bool synchronization = true;
	private double progress = 60;
	private string status = "Edit the controls to compare the themes.";
	private readonly Dictionary<string, object?> statusAttributes = new() { ["live"] = "polite" };

	// Bind through the application-wide service rather than a local flag: existing windows share the preference.
	private string Scheme
	{
		get => Appearance.ColorScheme switch { ColorScheme.Light => "light", ColorScheme.Dark => "dark", _ => "system" };
		set => Appearance.ColorScheme = value switch { "light" => ColorScheme.Light, "dark" => ColorScheme.Dark, _ => ColorScheme.System };
	}

	// UI strings are local to the picker; the public request uses typed portable presets or native material choices.
	// Unsupported materials retain an opaque theme background instead of making an unusable transparent window.
	private BackdropSelection SelectedBackdrop => backdrop switch
	{
		"blur" => CommonBackdrop.Blur,
		"solid" => CommonBackdrop.Solid,
		"mica" => WindowsBackdrop.Mica,
		"mica-alt" => WindowsBackdrop.MicaAlt,
		"acrylic" => WindowsBackdrop.Acrylic,
		"linux-blur" => LinuxBackdrop.Blur,
		_ => CommonBackdrop.None,
	};

	private void Save() => status = $"Saved: {name}";
	// Reset only the preview values; the independently selected theme, scheme, and backdrop remain in place.
	private void Reset()
	{
		name = "Nazor project";
		notifications = synchronization = true;
		progress = 60;
		status = "Controls reset.";
	}

}
