@window
@using Nazor.Controls.Primitives
@inject IApplicationAppearance Appearance

<UserTitleBar Class="workspace-titlebar"><TextBlock>Popup laboratory</TextBlock></UserTitleBar>
<Container Class="page">
	<Container Class="settings">
		<CheckBox Disabled="@(!Window.Capabilities.CanShowPopupsOutsideWindow)" @bind-IsChecked="Window.AllowPopupsOutsideWindow">External popups</CheckBox>
		<Button OnClick="ToggleTitleBar">Show / hide user title bar</Button>
		<Button OnClick="ToggleScheme">Light / dark</Button>
		<Button OnClick="ResizeWindow">Compact / large window</Button>
	</Container>
	<TextBlock>@($"External popup capability: {Window.Capabilities.CanShowPopupsOutsideWindow}. Requested: {Window.AllowPopupsOutsideWindow}.")</TextBlock>
	<Container Class="settings">
		<Field LabelText="Placement"><Select TValue="DropDownPlacement" Items="placements" @bind-Value="placement"/></Field>
		<Field LabelText="Preferred minimum"><Select TValue="int" Items="minimums" @bind-Value="minimum"/></Field>
		<Field LabelText="Preferred maximum"><Select TValue="int" Items="maximums" @bind-Value="maximum"/></Field>
	</Container>
	<Container Class="arena">
		<Container Class="row">
			<Field LabelText="Top edge">
				<Select TValue="string" Items="cities" @bind-Value="selected" DropDownPlacement="placement"
					PreferredMinVisibleItems="minimum" PreferredMaxVisibleItems="maximum"/>
			</Field>
			<Popover Title="Persistent popover" ShowCloseButton="true" CloseOnOutside="false" FocusOnOpen="false" Placement="OverlayPlacement.Right">
				<Trigger><Button>Open and move this window</Button></Trigger>
				<ChildContent><TextBlock>Drag the title bar or resize the window to follow this anchor.</TextBlock></ChildContent>
			</Popover>
		</Container>
		<ContextMenu>
			<Trigger><Container Class="context-target" TabIndex="0">Right-click near the right or bottom edge. Try Shift+F10 and nested menus.</Container></Trigger>
			<ChildContent>
				<MenuItem OnClick="@(() => command = "Copy")">Copy</MenuItem>
				<MenuItem OnClick="@(() => command = "Paste")">Paste</MenuItem>
				<Submenu>
					<ChildContent>More commands</ChildContent>
					<Content>
						<MenuItem OnClick="@(() => command = "Export")">Export</MenuItem>
						<MenuItem OnClick="@(() => command = "Inspect")">Inspect</MenuItem>
					</Content>
				</Submenu>
				<MenuSeparator/>
				<MenuItem Disabled="true">Unavailable command</MenuItem>
			</ChildContent>
		</ContextMenu>
		<TextBlock>@($"Selection: {selected ?? "none"}. Filtered choice: {destination ?? "none"}. Command: {command}.")</TextBlock>
		<Container Class="row">
			<Field LabelText="Bottom edge, grouped options">
				<Select TValue="string" @bind-Value="selected" DropDownPlacement="placement"
					PreferredMinVisibleItems="minimum" PreferredMaxVisibleItems="maximum">
					@foreach (var city in cities)
					{
						<SelectItem Value="@city" Group="@(Array.IndexOf(cities, city) < 6 ? "Nearby" : "Other destinations")" Disabled="@(city == "Vienna")">@city</SelectItem>
					}
				</Select>
			</Field>
			<Field LabelText="Bottom edge, type to filter">
				<ComboBox TItem="string" Items="cities" @bind-Value="destination" Placeholder="Type Milan or Rome"
					DropDownPlacement="placement" PreferredMinVisibleItems="minimum" PreferredMaxVisibleItems="maximum"/>
			</Field>
		</Container>
	</Container>
</Container>

@code {
	private readonly string[] cities = ["Milan", "Rome", "Paris", "Vienna", "Berlin", "Madrid", "Lisbon", "London", "Dublin", "Prague", "Warsaw", "Athens", "Oslo", "Stockholm", "Helsinki", "Copenhagen", "Amsterdam", "Brussels", "Zurich", "Budapest"];
	private readonly DropDownPlacement[] placements = Enum.GetValues<DropDownPlacement>();
	private readonly int[] minimums = [1, 2, 4];
	private readonly int[] maximums = [4, 6, 10, 16];
	private DropDownPlacement placement;
	private int minimum = 2, maximum = 6;
	private string? selected, destination;
	private string command = "none";
	private bool compact, titleBar;
	private async Task ToggleTitleBar()
	{
		titleBar = !titleBar;
		await Window.SetDecorationsAsync(WindowDecorationPolicy.Require(WindowDecorations.Nazor(
			titleBar ? WindowTitleBarContent.User : WindowTitleBarContent.None,
			titleBar ? WindowCaptionButtons.Nazor : WindowCaptionButtons.None)));
	}

	protected override void OnInitialized()
	{
		Window.Title = "Nazor popup laboratory";
		Window.Width = 900;
		Window.Height = 640;
		Window.Backdrop = WindowsBackdrop.Mica;
		Window.AllowPopupsOutsideWindow = true;
		//Window.Decorations = WindowDecorationPolicy.Prefer(WindowDecorations.Nazor(WindowTitleBarContent.Nazor, WindowCaptionButtons.Nazor));
		//Window.IsResizable = false;
	}

	private void ToggleScheme() => Appearance.ColorScheme = Appearance.ColorScheme == ColorScheme.Light ? ColorScheme.Dark : ColorScheme.Light;

	private void ResizeWindow()
	{
		compact = !compact;
		Window.Width = compact ? 760 : 900;
		Window.Height = compact ? 440 : 640;
	}
}

@style {
	:root {
	}
	.workspace-titlebar {
		height: var(--nz-window-controls-height, 32px);
		padding: 0 12px;
		display: flex;
		align-items: center;
	}
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 16px;
	}
	.settings, .row {
		display: flex;
		gap: 16px;
		align-items: end;
	}
	.settings Field {
		width: 180px;
	}
	.arena {
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 8px;
	}
	.row Field {
		width: 280px;
	}
	.context-target {
		padding: 24px;
		border: 1px dashed var(--nz-on-surface);
	}
	.page ::deep Menu, .page ::deep SelectPopup, .page ::deep ComboBoxPopup, .page ::deep PopoverContent {
		border-radius: 8px;
		box-shadow: 0 5px 14px #0006;
	}
}
