:root {
    --surface: #f3f3f3;
    --surface-alt: #f9f9f9;
    --panel: #ffffff;
    --hover: #eaeaea;
    --text: #1a1a1a;
    --muted: #5c5c5c;
    --border: #d1d1d1;
    --accent: #005fb8;
    --accent-hover: #0067c0;
    --on-accent: #ffffff;
    --selected: #e5f0fb;
    --positive: #0f7b0f;
}
