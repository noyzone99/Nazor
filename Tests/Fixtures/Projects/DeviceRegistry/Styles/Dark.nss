:root {
    --surface: #1c1c1c;
    --surface-alt: #232323;
    --panel: #2b2b2b;
    --hover: #363636;
    --text: #f0f0f0;
    --muted: #a6a6a6;
    --border: #474747;
    --accent: #4cc2ff;
    --accent-hover: #73d0ff;
    --on-accent: #002b45;
    --selected: #18344a;
    --positive: #6ccb5f;
}
