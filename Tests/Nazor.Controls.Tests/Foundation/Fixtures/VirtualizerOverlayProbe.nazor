@using Nazor.Controls.Primitives
@implements IRefreshable
<Virtualizer TItem="int" @ref="List" Items="Values" ItemSize="40" MeasureItems="true" Style="height: 140px; width: 260px; position: relative; overflow-y: auto">
    <OverlayContent><Container Id="hover-overlay" Style="position: absolute; top: 0; left: 0; width: 20px; height: 20px" @attributes="DecorationAttributes" /></OverlayContent>
    <ItemTemplate Context="row"><Container Style="@($"height: {row.Item}px")">@row.Index</Container></ItemTemplate>
</Virtualizer>
@code {
    public Virtualizer<int> List { get; set; } = null!;
    public IReadOnlyList<int> Values { get; set; } = Enumerable.Range(0, 100).Select(index => index % 2 == 0 ? 24 : 64).ToArray();
    private readonly IReadOnlyDictionary<string, object?> DecorationAttributes = new Dictionary<string, object?> { ["semantic-hidden"] = true };
    public void Refresh() => StateHasChanged();
}
