<Container Style="padding-top: 120px; padding-left: 16px;">
    <Select TValue="string" Items="items" PreferredMinVisibleItems="2" PreferredMaxVisibleItems="4" />
    <ComboBox TItem="string" Items="items" PreferredMaxVisibleItems="4" Placeholder="Type an item"
              DropDownPlacement="comboPlacement" @bind-Value="Chosen">
        <EmptyContent>No matching items</EmptyContent>
    </ComboBox>
</Container>

@code {
    private readonly string[] items = Enumerable.Range(1, 20).Select(index => $"Item {index:D2}").ToArray();

    public string? Chosen { get; set; }
    private DropDownPlacement comboPlacement = DropDownPlacement.Top;

    public void UseAutomaticPlacement()
    {
        comboPlacement = DropDownPlacement.Auto;
        StateHasChanged();
    }
}
