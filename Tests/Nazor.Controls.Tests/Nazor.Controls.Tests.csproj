<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <NazorApplicationId>org.nazor.controlstests</NazorApplicationId>
    <RootNamespace>Nazor.Controls.Tests</RootNamespace>
    <NazorImplicitRuntimeReference>false</NazorImplicitRuntimeReference>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="../../Sources/Core/Nazor.Presentation/Nazor.Presentation.csproj" />
    <ProjectReference Include="../../Sources/Core/Nazor.Renderer.Skia/Nazor.Renderer.Skia.csproj" />
    <ProjectReference Include="../../Sources/Core/Nazor.Input/Nazor.Input.csproj" />
    <ProjectReference Include="../../Sources/Tools/Nazor.Nss.Compiler/Nazor.Nss.Compiler.csproj" />
    <ProjectReference Include="../Nazor.Testing/Nazor.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Nazor.Rendering" />
    <Using Include="Nazor.Testing" />
    <None Include="../Assets/Fonts/*.ttf" Link="Fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../Sources/Tools/Nazor.Sdk/build/Nazor.targets" />
</Project>
