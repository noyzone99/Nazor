<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <VisualStudioIde Condition="'$(VisualStudioIde)' == ''">$(ProgramFiles)/Microsoft Visual Studio/18/Community/Common7/IDE</VisualStudioIde>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.VisualStudio.Interop">
      <HintPath>$(VisualStudioIde)/PublicAssemblies/Microsoft.VisualStudio.Interop.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>
</Project>
