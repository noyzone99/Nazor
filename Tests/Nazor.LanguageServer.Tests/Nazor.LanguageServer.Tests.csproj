    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Nazor.TestSdkDirectory" Value="$([MSBuild]::EnsureTrailingSlash('$(NetCoreRoot)'))sdk/$(NazorLanguageServicesSdkVersion)" />
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="../../Sources/Tools/Nazor.LanguageServer/Nazor.LanguageServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
