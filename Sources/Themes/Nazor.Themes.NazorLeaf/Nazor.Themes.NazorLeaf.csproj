<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Nazor.Themes.NazorLeaf</RootNamespace>
    <Description>NazorLeaf, the Nazor visual language: leaf corners, the seed selection mark, accent glow and the four-leaf mark, with private text/icon fonts, typed LeafSymbol icons and the LeafTitlebar.</Description>
    <EnableDefaultNazorAssets>false</EnableDefaultNazorAssets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Core/Nazor.Graphics/Nazor.Graphics.csproj" />
  </ItemGroup>

  <!-- Fonts are copied next to the application, under Themes/NazorLeaf, where NazorLeafTheme finds them. -->
  <ItemGroup>
    <None Remove="Fonts/**;buildTransitive/Nazor.Themes.NazorLeaf.targets" />
    <None Include="Fonts/*.ttf;Fonts/*.otf;Fonts/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Themes/NazorLeaf/%(Filename)%(Extension)" Pack="true" PackagePath="assets/" />
    <None Include="buildTransitive/Nazor.Themes.NazorLeaf.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.it.resx">
      <DependentUpon>Strings.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <Import Project="../../Tools/Nazor.Sdk/build/Nazor.targets" />
</Project>
