<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Nazor Component</Name>
    <Description>A Nazor component with markup, scoped styles and C# members.</Description>
    <Icon>Component.png</Icon>
    <ProjectType>CSharp</ProjectType>
    <DefaultName>Component.nazor</DefaultName>
    <TemplateID>Nazor.Component</TemplateID>
    <ShowByDefault>true</ShowByDefault>
    <SortOrder>30</SortOrder>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.nazor">Component.nazor</ProjectItem>
  </TemplateContent>
</VSTemplate>
