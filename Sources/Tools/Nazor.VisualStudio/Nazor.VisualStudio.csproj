<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <ProjectGuid>{6B7C3E2A-0F5D-4C1E-9A3B-2E8D1F4C7A90}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Nazor.VisualStudio</RootNamespace>
    <AssemblyName>Nazor.VisualStudio</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <LangVersion>latest</LangVersion>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="NazorLanguageClient.cs" />
    <Compile Include="NazorCSharpOptions.cs" />
    <Compile Include="NazorRoslynAssemblies.cs" />
    <Compile Include="NazorSnippets.cs" />
    <Compile Include="NazorEditingCommands.cs" />
    <Compile Include="NazorEditingContext.cs" />
    <Compile Include="NazorCSharpEditing.cs" />
    <Compile Include="NazorIndentation.cs" />
    <Compile Include="..\..\Shared\Authoring\CodeIndentation.cs" Link="Shared\CodeIndentation.cs" />
    <Compile Include="..\Nazor.LanguageServer\Features\CSharpLexer.cs" Link="Shared\CSharpLexer.cs" />
    <Compile Include="NazorParameterClassification.cs" />
    <Compile Include="NazorViewCode.cs" />
    <Compile Include="NazorGeneratedCode.cs" />
    <Compile Include="NazorReferences.cs" />
    <Compile Include="NazorCodeLens.cs" />
    <Compile Include="NazorNssReferences.cs" />
    <Compile Include="NativeCodeLensReferences.cs" />
    <Compile Include="SnippetConversion.cs" />
    <Compile Include="NazorComments.cs" />
    <Compile Include="NazorCommentCommands.cs" />
    <Compile Include="NazorCompletion.cs" />
    <Compile Include="NazorSidecars.cs" />
    <Compile Include="NazorCompletionImages.cs" />
    <Compile Include="NazorProjectIcons.cs" />
    <Compile Include="NazorHotReloadPackage.cs" />
    <Compile Include="NazorBreakpointReader.cs" />
    <Compile Include="NazorDebuggerInspection.cs" />
    <Compile Include="NazorDevToolsCommand.cs" />
    <VSCTCompile Include="NazorCommands.vsct"><ResourceName>Menus.ctmenu</ResourceName></VSCTCompile>
    <Compile Include="NazorQuickAdd.cs" />
    <Compile Include="QuickAddMappings.cs" />
    <Compile Include="HotReloadFiles.cs" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Design" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="Nazor.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="NazorIcons.imagemanifest">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Page Include="Icons\*.xaml" />
    <Content Include="..\..\..\Docs\Assets\nazor.png">
      <Link>nazor.png</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\..\..\LICENSE">
      <Link>LICENSE.txt</Link>
      <TargetPath>LICENSE.txt</TargetPath>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="obj\$(Configuration)\NazorComponent.zip">
      <Link>ItemTemplates\CSharp\Nazor\NazorComponent.zip</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ItemTemplates\CSharp\Nazor</VSIXSubPath>
    </Content>
    <Content Include="obj\$(Configuration)\NazorStyleSheet.zip">
      <Link>ItemTemplates\CSharp\Nazor\NazorStyleSheet.zip</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ItemTemplates\CSharp\Nazor</VSIXSubPath>
    </Content>
    <Content Include="..\Nazor.Grammars\*.json;..\Nazor.Grammars\*.tmTheme;..\Nazor.Grammars\*.txt">
      <Link>Grammars\%(Filename)%(Extension)</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>Grammars</VSIXSubPath>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nazor.VisualStudio.CodeLens\Nazor.VisualStudio.CodeLens.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <Content Include="..\Nazor.VisualStudio.CodeLens\bin\$(Configuration)\Nazor.VisualStudio.CodeLens.dll">
      <Link>Nazor.VisualStudio.CodeLens.dll</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.ProjectSystem" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(NazorServerDirectory)' != ''">
    <Content Include="$(NazorServerDirectory)\**\*">
      <Link>Server\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>Server\%(RecursiveDir)</VSIXSubPath>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(NazorCompletionImagesDirectory)' != ''">
    <Content Include="$(NazorCompletionImagesDirectory)\NazorCompletionColors.imagemanifest">
      <Link>NazorCompletionColors.imagemanifest</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Page Include="$(NazorCompletionImagesDirectory)\CompletionColors\*.xaml">
      <Link>CompletionColors\%(Filename)%(Extension)</Link>
    </Page>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="NazorComponentTemplate" BeforeTargets="BeforeBuild">
    <MakeDir Directories="obj\$(Configuration)" />
    <ZipDirectory SourceDirectory="ItemTemplates\NazorComponent" DestinationFile="obj\$(Configuration)\NazorComponent.zip" Overwrite="true" />
    <ZipDirectory SourceDirectory="ItemTemplates\NazorStyleSheet" DestinationFile="obj\$(Configuration)\NazorStyleSheet.zip" Overwrite="true" />
  </Target>
  <Target Name="NazorProjectTemplate" BeforeTargets="GetVsixSourceItems" Condition="'$(DesignTimeBuild)' != 'true'">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\..\..\Directory.Build.props" Query="/Project/PropertyGroup/NazorVersion/text()">
      <Output TaskParameter="Result" PropertyName="_NazorProjectTemplateVersion" />
    </XmlPeek>
    <PropertyGroup>
      <_NazorProjectTemplateDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'ProjectTemplates'))</_NazorProjectTemplateDirectory>
      <_NazorProjectTemplatePackage>$(_NazorProjectTemplateDirectory)\Nazor.Templates.$(_NazorProjectTemplateVersion).nupkg</_NazorProjectTemplatePackage>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="dotnet pack &quot;..\Nazor.Templates\Nazor.Templates.csproj&quot; -c &quot;$(Configuration)&quot; -o &quot;$(_NazorProjectTemplateDirectory)&quot; -m:1 -nodeReuse:false -p:UseSharedCompilation=false -p:EnableSourceControlManagerQueries=false -v:quiet" />
    <Error Condition="!Exists('$(_NazorProjectTemplatePackage)')" Text="The Nazor project template package for $(_NazorProjectTemplateVersion) was not built." />
    <ItemGroup>
      <VSIXSourceItem Include="$(_NazorProjectTemplatePackage)">
        <VSIXSubPath>ProjectTemplates</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />
</Project>
