<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="TargetFramework">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nazor.Compiler</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <NazorRazorCompilerDirectory>$([MSBuild]::EnsureTrailingSlash('$(NetCoreRoot)'))sdk/$(NazorLanguageServicesSdkVersion)/Sdks/Microsoft.NET.Sdk.Razor/source-generators/</NazorRazorCompilerDirectory>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Nazor.Nss.Compiler/Nazor.Nss.Compiler.csproj" />
    <Reference Include="Microsoft.CodeAnalysis.Razor.Compiler" HintPath="$(NazorRazorCompilerDirectory)Microsoft.CodeAnalysis.Razor.Compiler.dll" />
    <Reference Include="Microsoft.AspNetCore.Razor.Utilities.Shared" HintPath="$(NazorRazorCompilerDirectory)Microsoft.AspNetCore.Razor.Utilities.Shared.dll" />
    <Compile Include="../../Shared/DevChannel/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Nazor.Compiler.Tests" />
  </ItemGroup>
  <Import Project="../Nazor.Roslyn.props" />
  <Target Name="_NazorCheckCompilerReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(NazorRazorCompilerDirectory)Microsoft.CodeAnalysis.Razor.Compiler.dll')"
           Text="Nazor.Compiler needs the pinned Razor compiler supplied by SDK $(NazorLanguageServicesSdkVersion), not found under '$(NazorRazorCompilerDirectory)'. The compiler runs on .NET 10 LTS." />
  </Target>
</Project>
