<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Description>Versioned, platform-independent Nazor DevTools wire contracts and bounded JSON-RPC messaging.</Description>
  </PropertyGroup>
  <ItemGroup><InternalsVisibleTo Include="Nazor.DevTools.Protocol.Tests" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="Transport/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <Compile Include="../../Shared/DevChannel/JsonRpcConnection.cs" Link="Transport/JsonRpcConnection.cs" />
  </ItemGroup>
</Project>
