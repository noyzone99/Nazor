/* Styles, Computed and Properties as a small NazorLeaf tab strip under the element header. */
.sidebar-tabs { flex: 1; min-height: 0; width: 100%; }
.sidebar-tabs > TabsHeader { padding: 0 14px; }
.sidebar-tabs TabsList { align-self: flex-start; }
.sidebar-tabs > TabsPanel { display: flex; flex-direction: column; flex: 1; min-height: 0; padding: 4px 0 0; gap: 0; }
