{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "information_for_contributors": [
    "NSS: the CSS subset of Nazor with nesting. Property names, value keywords and colors follow the NSS compiler;",
    "Nazor.Tooling.Tests checks them against Nazor.Style."
  ],
  "name": "NSS",
  "scopeName": "source.nss",
  "fileTypes": [
    "nss"
  ],
  "patterns": [
    {
      "include": "#stylesheet"
    }
  ],
  "repository": {
    "stylesheet": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#at-rule"
        },
        {
          "include": "#selector"
        },
        {
          "include": "#block"
        }
      ]
    },
    "comment": {
      "name": "comment.block.nss",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.nss"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.nss"
        }
      }
    },
    "at-rule": {
      "patterns": [
        {
          "name": "meta.at-rule.media.nss",
          "begin": "(@)media(?![\\w-])",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.at-rule.media.nss"
            },
            "1": {
              "name": "punctuation.definition.keyword.nss"
            }
          },
          "end": "(?<=\\})",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#media-query"
            },
            {
              "include": "#block"
            }
          ]
        },
        {
          "name": "meta.at-rule.keyframes.nss",
          "begin": "(@)keyframes(?![\\w-])",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.at-rule.keyframes.nss"
            },
            "1": {
              "name": "punctuation.definition.keyword.nss"
            }
          },
          "end": "(?<=\\})",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "name": "entity.name.function.keyframes.nss",
              "match": "[A-Za-z_-][\\w-]*|\"(?:[^\"\\\\]|\\\\[\\s\\S])*\"|'(?:[^'\\\\]|\\\\[\\s\\S])*'"
            },
            {
              "name": "meta.keyframes-list.nss",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.property-list.begin.nss"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.property-list.end.nss"
                }
              },
              "patterns": [
                {
                  "include": "#comment"
                },
                {
                  "name": "entity.other.keyframe-offset.nss",
                  "match": "(?i)(?<![\\w-])(?:from|to)(?![\\w-])|(?<![\\w.-])\\d+(?:\\.\\d+)?%"
                },
                {
                  "name": "punctuation.separator.list.comma.nss",
                  "match": ","
                },
                {
                  "include": "#block"
                }
              ]
            }
          ]
        },
        {
          "name": "invalid.illegal.at-rule.nss",
          "match": "@[\\w-]+"
        }
      ]
    },
    "media-query": {
      "patterns": [
        {
          "name": "keyword.operator.logical.nss",
          "match": "(?<![\\w-])(?:and|not|only)(?![\\w-])"
        },
        {
          "name": "meta.media-feature.nss",
          "begin": "\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.parameters.begin.nss"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.parameters.end.nss"
            }
          },
          "patterns": [
            {
              "name": "support.type.property-name.media.nss",
              "match": "(?<![\\w-])(?:min\\-width|max\\-width|min\\-height|max\\-height|prefers\\-color\\-scheme|prefers\\-reduced\\-motion|forced\\-colors|prefers\\-contrast|platform|density)(?![\\w-])"
            },
            {
              "name": "invalid.illegal.media-feature.nss",
              "match": "[A-Za-z][\\w-]*(?=\\s*:)"
            },
            {
              "name": "punctuation.separator.key-value.nss",
              "match": ":"
            },
            {
              "name": "support.constant.property-value.nss",
              "match": "(?<![\\w-])(?:middle|shrink|standard|tall|light|dark|reduce|no\\-preference|active|none|more|less|windows|linux|macos|android|ios|compact|touch)(?![\\w-])"
            },
            {
              "include": "#number"
            }
          ]
        }
      ]
    },
    "selector": {
      "name": "meta.selector.nss",
      "begin": "(?=[A-Za-z_.#&*:>\\[+~])",
      "end": "(?=[{};])",
      "patterns": [
        {
          "include": "#selector-items"
        }
      ]
    },
    "block": {
      "name": "meta.property-list.nss",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.property-list.begin.nss"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.property-list.end.nss"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#at-rule"
        },
        {
          "include": "#declaration"
        },
        {
          "include": "#selector"
        },
        {
          "include": "#block"
        },
